root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = when_multiline:silent
dotnet_sort_system_directives_first = true

# Game hot paths use explicit loops on purpose.
dotnet_diagnostic.CA1851.severity = none
# Short-lived console services log via Console for M0; structured logging comes with OpenTelemetry.
dotnet_diagnostic.CA1303.severity = none
# Only matters for VB.NET consumers; we have none.
dotnet_diagnostic.CA1716.severity = none
