; Godot project settings. Input actions are registered in code (src/Controls.cs) so key
; bindings are reviewable C# rather than serialized input events.
config_version=5

[application]
config/name="Meridian"
config/description="Project Meridian client"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
; UI is laid out for 1600x900 and scales with the window (3D renders at full resolution).
; "expand" shows more of the world, not black bars, on other aspect ratios. src/WindowScale.cs
; sizes the window for the monitor's DPI at startup.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true
window/vsync/vsync_mode=1

[dotnet]
project/assembly_name="Meridian.Client"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
